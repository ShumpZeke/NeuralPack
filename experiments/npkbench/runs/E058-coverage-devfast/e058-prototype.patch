+#: Experimental scan profiles (E058): authored source and test file types the default scan
+#: skips, indexed in addition to ``TEXT_SUFFIXES``. Non-default profiles also keep a directory
+#: named ``env``/``venv`` unless it is a virtualenv (``pyvenv.cfg`` or an ``activate`` script).
+CORE_EXTRA_SUFFIXES = {
+    ".cc": "cpp", ".cxx": "cpp", ".hh": "cpp", ".hxx": "cpp", ".ipp": "cpp", ".inl": "cpp",
+    ".mjs": "javascript", ".cjs": "javascript", ".mts": "typescript", ".cts": "typescript",
+    ".vue": "vue", ".svelte": "svelte", ".pyx": "cython", ".pxd": "cython", ".pxi": "cython",
+    ".y": "yacc", ".l": "lex", ".tcl": "tcl", ".proto": "protobuf",
+}
+CORE_NO_TCL = {k: v for k, v in CORE_EXTRA_SUFFIXES.items() if k != ".tcl"}
+SUFFIX_PROFILES = {
+    "default": {},
+    "core": CORE_EXTRA_SUFFIXES,
+    "core_test": {**CORE_EXTRA_SUFFIXES, ".test": "text"},
+    "core_test_snap": {**CORE_EXTRA_SUFFIXES, ".test": "text", ".snap": "text"},
+    "core_notcl": CORE_NO_TCL,
+    "core_notcl_test": {**CORE_NO_TCL, ".test": "text"},
+}
+
+
+def _excluded_dir(parent: str, name: str, detect_env: bool) -> bool:
+    """Whether the scan skips directory *name* of *parent* (dot directories always)."""
+    if name.startswith("."):
+        return True
+    if name not in EXCLUDED_DIRS:
+        return False
+    if detect_env and name in ("env", "venv"):
+        base = os.path.join(parent, name)
+        return any(os.path.exists(os.path.join(base, marker))
+                   for marker in ("pyvenv.cfg", os.path.join("bin", "activate"),
+                                  os.path.join("Scripts", "activate")))
+    return True
+
