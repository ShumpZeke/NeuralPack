diff --git a/tests/test_suffix_profiles.py b/tests/test_suffix_profiles.py
new file mode 100644
index 0000000..14d85db
--- /dev/null
+++ b/tests/test_suffix_profiles.py
@@ -0,0 +1,47 @@
+"""Scan profiles index authored source and test file types and keep real source in env/ (E058)."""
+import pytest
+
+from npk.pack import compile_pack
+from npk.pack.format import open_pack
+
+
+def _tree(root):
+    for path, text in {
+        "keep.py": "x = 1\n",
+        "src/uu/env/src/env.rs": "fn main() {}\n",
+        "lib/x.cc": "int f() { return 1; }\n",
+        "lib/y.mjs": "export const a = 1;\n",
+        "tests/case.test": "[case t]\nx = 1\n",
+        "snap/__snapshots__/a.snap": "exports[`a`] = `b`;\n",
+        "parser.y": "%% grammar\n",
+        "venv/pyvenv.cfg": "home = /usr\n",
+        "venv/lib/python3.12/site-packages/foo.py": "x = 1\n",
+        "env/bin/activate": "#!/bin/sh\n",
+        "env/bin/tool.py": "y = 2\n",
+    }.items():
+        target = root / path
+        target.parent.mkdir(parents=True, exist_ok=True)
+        target.write_text(text)
+
+
+def _files(tmp_path, profile):
+    out = tmp_path / f"{profile}.npk"
+    compile_pack(tmp_path / "src", out, suffix_profile=profile)
+    with open_pack(out) as con:
+        return {row[0] for row in con.execute("SELECT path FROM files")}
+
+
+def test_profiles_add_file_types_and_keep_env_source_but_not_virtualenvs(tmp_path):
+    _tree(tmp_path / "src")
+    assert _files(tmp_path, "default") == {"keep.py"}
+    core = _files(tmp_path, "core")
+    assert core == {"keep.py", "lib/x.cc", "lib/y.mjs", "parser.y", "src/uu/env/src/env.rs"}
+    assert _files(tmp_path, "core_test") == core | {"tests/case.test"}
+    assert _files(tmp_path, "core_test_snap") == core | {"tests/case.test", "snap/__snapshots__/a.snap"}
+
+
+def test_unknown_profile_is_rejected(tmp_path):
+    (tmp_path / "src").mkdir()
+    (tmp_path / "src" / "a.py").write_text("x = 1\n")
+    with pytest.raises(ValueError):
+        compile_pack(tmp_path / "src", tmp_path / "p.npk", suffix_profile="everything")
