diff --git a/npk/pack/integrity.py b/npk/pack/integrity.py
index 7f249b9..6e245ca 100644
--- a/npk/pack/integrity.py
+++ b/npk/pack/integrity.py
@@ -14,6 +14,8 @@ import sqlite3
 from .format import PackError
 
 LOCAL_TABLES=("files","provenance","blocks","symbols","relations","embeddings","assignments")
+#: Above this many changed files, leaves are computed with one scan per table.
+BULK_DIGEST_MIN_FILES=64
 GLOBAL_TABLES=("manifest","deps","lexical_data","lexical_idx","lexical_docsize",
                "lexical_config","integrity_files","integrity_dirty")
 
@@ -64,9 +66,47 @@ def framed(value):
     return tag+len(data).to_bytes(8,"big")+data
 
 
+_FRAMED_NONE=framed(None)
+
+
 def _feed_rows(digest,rows):
+    """Feed framed rows; byte-for-byte the stream of framed(len(row)) + framed(value)...
+
+    Inlines the common str/int/bytes/None cases and hashes in batches: a Django
+    compile frames about 500K values, and per-value calls dominated sealing.
+    Any other type goes through framed(), which keeps its exact bytes or error.
+    """
+    update=digest.update
+    chunks=[]
+    append=chunks.append
+    row_frames={}
     for row in rows:
-        digest.update(framed(len(row))+b"".join(framed(value) for value in row))
+        width=len(row)
+        head=row_frames.get(width)
+        if head is None:
+            head=row_frames[width]=framed(width)
+        append(head)
+        for value in row:
+            kind=type(value)
+            if kind is str:
+                data=value.encode("utf-8")
+                append(b"s"+len(data).to_bytes(8,"big"))
+                append(data)
+            elif kind is int:
+                data=str(value).encode("ascii")
+                append(b"i"+len(data).to_bytes(8,"big")+data)
+            elif kind is bytes:
+                append(b"b"+len(value).to_bytes(8,"big"))
+                append(value)
+            elif value is None:
+                append(_FRAMED_NONE)
+            else:
+                append(framed(value))
+        if len(chunks)>=8192:
+            update(b"".join(chunks))
+            chunks.clear()
+    if chunks:
+        update(b"".join(chunks))
 
 
 def _rows(con,table,where="",params=()):
@@ -86,9 +126,40 @@ def file_digest(con,file_id):
     return digest.digest()
 
 
+def bulk_file_digests(con,file_ids=None):
+    """file_digest() for many files with one ordered scan per table.
+
+    Byte-identical to calling file_digest per file: every file's hash sees the
+    same table frames and the same rows in the same order (all columns, then
+    BINARY collation), but 7 scans replace 7 queries per file.
+    """
+    ids=sorted(file_ids) if file_ids is not None else [r[0] for r in con.execute("SELECT id FROM files ORDER BY id")]
+    digests={file_id:hashlib.sha256(b"npk-integrity-v8-file\0") for file_id in ids}
+    for table in LOCAL_TABLES:
+        head=framed(table)
+        for digest in digests.values():
+            digest.update(head)
+        count=len(con.execute(f'SELECT * FROM "{table}" LIMIT 0').description)
+        order=",".join(f"t.{c[0]}" for c in con.execute(f'SELECT * FROM "{table}" LIMIT 0').description)
+        if table=="files":owner="t.id"
+        elif table in {"blocks","provenance"}:owner="t.file_id"
+        else:owner="(SELECT b.file_id FROM blocks b WHERE b.id=t.block_id)"
+        rows=con.execute(f'SELECT {owner},t.* FROM "{table}" t ORDER BY 1,{order}')
+        current=None
+        batch=[]
+        for row in rows:
+            if row[0]!=current:
+                if batch and current in digests:
+                    _feed_rows(digests[current],batch)
+                current,batch=row[0],[]
+            batch.append(row[1:count+1])
+        if batch and current in digests:
+            _feed_rows(digests[current],batch)
+    return {file_id:digest.digest() for file_id,digest in digests.items()}
+
+
 def full_file_digests(con):
-    ids=[r[0] for r in con.execute("SELECT id FROM files ORDER BY id")]
-    return {file_id:file_digest(con,file_id) for file_id in ids}
+    return bulk_file_digests(con)
 
 
 def cached_file_digests(con):
@@ -131,9 +202,12 @@ def refresh_file_digests(con):
     dirty={r[0] for r in con.execute("SELECT file_id FROM integrity_dirty")}
     cached={r[0] for r in con.execute("SELECT file_id FROM integrity_files")}
     refresh=(dirty & ids)|(ids-cached)
+    # One scan per table beats per-file queries once many files changed.
+    fresh=(bulk_file_digests(con,refresh) if len(refresh)>BULK_DIGEST_MIN_FILES
+           else {file_id:file_digest(con,file_id) for file_id in refresh})
     for file_id in sorted(refresh):
         con.execute("INSERT INTO integrity_files(file_id,digest) VALUES(?,?) ON CONFLICT(file_id) DO UPDATE SET digest=excluded.digest",
-                    (file_id,file_digest(con,file_id)))
+                    (file_id,fresh[file_id]))
     # FK cascades normally remove these; explicit pruning also covers initial state.
     con.execute("DELETE FROM integrity_files WHERE file_id NOT IN (SELECT id FROM files)")
     con.execute("DELETE FROM integrity_dirty")
