+def test_bulk_leaves_equal_per_file_leaves_across_every_local_table(tmp_path):
+    source=tmp_path/"source";source.mkdir()
+    for i in range(5):
+        (source/f"m{i}.py").write_text(f"LIMIT_{i} = {i}\nclass Err{i}(Exception):\n    pass\n"
+                                        f"def run_{i}(x):\n    if x:\n        raise Err{i}('bad')\n    return LIMIT_{i}\n")
+    (source/"README.md").write_text("# Title\n\nSome prose.\n")
+    # Rows stored out of sorted order: the bulk scan must still sort within a file.
+    (source/"order.py").write_text("ZETA = 1\nALPHA = 2\ndef zeta():\n    return ZETA\ndef alpha():\n    return ALPHA\n")
+    target=tmp_path/"project.npk";compile_pack(source,target)
+    integrity=importlib.import_module("npk.pack.integrity")
+    with closing(sqlite3.connect(target)) as con:
+        counts={t:con.execute(f'SELECT COUNT(*) FROM "{t}"').fetchone()[0] for t in ("symbols","relations","assignments")}
+        assert all(counts.values()), counts
+        ids=[r[0] for r in con.execute("SELECT id FROM files ORDER BY id")]
+        assert integrity.bulk_file_digests(con)=={i:integrity.file_digest(con,i) for i in ids}
+        assert integrity.bulk_file_digests(con,ids[1:3])=={i:integrity.file_digest(con,i) for i in ids[1:3]}
