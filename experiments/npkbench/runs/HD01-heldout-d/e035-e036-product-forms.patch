+    def _place_file_header(self, con, ordered_ids: List[int], budget: int,
+                           fused: Dict[int, float], channels_of: Dict[int, List[str]]) -> List[int]:
+        """Put the top implementation file's module header right after its top block.
+
+        The header is the file's first module-level block (imports and module
+        constants). Import edits are part of many fixes, and the header shows
+        which names are in scope for a change in that file (E036). It is placed
+        only if it costs at most ``budget // FILE_HEADER_DIVISOR`` tokens and is
+        not already ranked above that block.
+        """
+        paths = dict(con.execute(
+            f"SELECT b.id, f.path FROM blocks b JOIN files f ON f.id=b.file_id "
+            f"WHERE b.id IN ({','.join('?' * len(ordered_ids))})", ordered_ids).fetchall())
+        top = next((b for b in ordered_ids
+                    if not TEST_PATH.search(paths.get(b, "")) and not DOC_PATH.search(paths.get(b, ""))), None)
+        if top is None:
+            return ordered_ids
+        header = con.execute(
+            "SELECT b.id, b.tokens FROM blocks b JOIN files f ON f.id=b.file_id "
+            "WHERE f.path=? AND b.kind='module' AND b.start_line=1", (paths[top],)).fetchone()
+        if (header is None or header[0] == top or header[1] > budget // FILE_HEADER_DIVISOR
+                or header[0] in ordered_ids[:ordered_ids.index(top)]):
+            return ordered_ids
+        reordered = [b for b in ordered_ids if b != header[0]]
+        reordered.insert(reordered.index(top) + 1, header[0])
+        fused.setdefault(header[0], 0.0)
+        channels_of.setdefault(header[0], []).append("file_header")
+        return reordered
