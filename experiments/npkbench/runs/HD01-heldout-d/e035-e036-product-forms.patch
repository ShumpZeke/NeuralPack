diff --git a/tests/test_file_header.py b/tests/test_file_header.py
new file mode 100644
index 0000000..4475e53
--- /dev/null
+++ b/tests/test_file_header.py
@@ -0,0 +1,67 @@
+"""The top implementation file's module header follows its top block (E036)."""
+import json
+import subprocess
+import sys
+
+import pytest
+
+from npk.pack import PackSelector, compile_pack
+
+QUERY = "retry backoff delay grows too fast\nbackoff_delay() doubles on every attempt."
+
+
+@pytest.fixture()
+def pack(tmp_path):
+    src = tmp_path / "src"
+    (src / "pkg").mkdir(parents=True)
+    (src / "pkg" / "throttle.py").write_text(
+        "import math\nimport random\n\nMAX_DELAY = 60\n\n\n"
+        "def backoff_delay(attempt, base):\n    '''Exponential backoff delay for a retry attempt.'''\n"
+        "    return min(MAX_DELAY, base * 2 ** attempt)\n")
+    for i in range(15):
+        (src / "pkg" / f"policy{i}.py").write_text(
+            f"def retry_policy_{i}(attempt):\n    '''Retry backoff delay grows for attempt {i}.'''\n"
+            f"    return attempt * {i + 1}\n")
+    out = tmp_path / "p.npk"
+    compile_pack(src, out)
+    return out
+
+
+def _evidence(pack, budget, **options):
+    with PackSelector(str(pack), enable_cache=False, **options) as selector:
+        return selector.select(QUERY, budget_tokens=budget, allow_escalation=False).evidence
+
+
+def test_header_follows_the_top_block(pack):
+    chosen = _evidence(pack, 300)
+    assert chosen[0].path == "pkg/throttle.py" and chosen[0].name == "backoff_delay"
+    assert chosen[1].path == "pkg/throttle.py" and chosen[1].kind == "module"
+    assert chosen[1].span.startswith("pkg/throttle.py:1-") and "file_header" in chosen[1].channels
+    plain = _evidence(pack, 300, enable_file_header=False)
+    assert plain[0].name == "backoff_delay" and plain[1].path != "pkg/throttle.py"
+    assert all("file_header" not in e.channels for e in plain)
+
+
+def test_header_is_skipped_when_it_exceeds_its_budget_share(pack):
+    header_tokens = _evidence(pack, 300)[1].tokens
+    small = header_tokens * 8 - 8   # budget // 8 < header tokens
+    chosen = _evidence(pack, small)
+    assert chosen[0].name == "backoff_delay"
+    assert all("file_header" not in e.channels for e in chosen)
+    assert any("file_header" in e.channels for e in _evidence(pack, header_tokens * 8))
+
+
+def test_file_header_flag_must_be_boolean(pack):
+    with pytest.raises(ValueError, match="enable_file_header"):
+        PackSelector(str(pack), enable_file_header="yes")
+
+
+def test_cli_no_file_header(pack):
+    def cli(*extra):
+        out = subprocess.run([sys.executable, "-m", "npk.cli", "query", str(pack), QUERY, "--budget", "300",
+                              *extra], capture_output=True, text=True, check=True).stdout
+        return [item["span"] for item in json.loads(out)["evidence"]]
+
+    assert cli() == [e.span for e in _evidence(pack, 300)]
+    assert cli("--no-file-header") == [e.span for e in _evidence(pack, 300, enable_file_header=False)]
+    assert cli() != cli("--no-file-header")
