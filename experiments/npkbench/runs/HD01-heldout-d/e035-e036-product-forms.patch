+        chosen = selector.select(query, budget_tokens=10**6, allow_escalation=False).evidence
+    assert chosen[0].path == "pkg/cache/backends.py"
+    mate = [e for e in chosen if "test_mate" in e.channels]
+    assert [e.path for e in mate] == ["tests/cache/test_expiry.py"]
