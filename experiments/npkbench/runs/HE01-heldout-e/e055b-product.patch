diff --git a/tests/test_traceback_frames.py b/tests/test_traceback_frames.py
new file mode 100644
index 0000000..e0b65d2
--- /dev/null
+++ b/tests/test_traceback_frames.py
@@ -0,0 +1,87 @@
+"""Traceback frames rank the functions a failure passed through, from 2K (E055b)."""
+import importlib
+
+import pytest
+
+from npk.pack import PackSelector, compile_pack
+from npk.pack.format import open_pack
+
+selection = importlib.import_module("npk.pack.select")
+
+TRACEBACK = """Wrong result for negative values
+Calling it on negative values returns the wrong result.
+
+Traceback (most recent call last):
+  File "/home/u/venv/lib/python3.8/site-packages/pkg/ops/base.py", line {line}, in __call__
+TypeError: unsupported operand type(s)
+"""
+
+
+def test_frames_are_read_in_every_pasted_format():
+    text = ('  File "/x/site-packages/pkg/a.py", line 3, in run\n'
+            "File ~/lib/site-packages/pkg/b.py:7, in Model.fit(self)\n"
+            "~/env/lib/python3.9/site-packages/pkg/c.py in helper(x)\n"
+            "pkg/d.py:12: in test_thing\n"
+            '  File "<stdin>", line 1, in <module>\n')
+    assert selection._traceback_frames(text) == [
+        ("/x/site-packages/pkg/a.py", 3, "run"), ("~/lib/site-packages/pkg/b.py", 7, "Model.fit"),
+        ("~/env/lib/python3.9/site-packages/pkg/c.py", None, "helper"), ("pkg/d.py", 12, "test_thing")]
+
+
+def test_frame_paths_resolve_by_path_suffix():
+    by_name = {"core.py": ["src/pkg/core.py", "other/core.py"], "__init__.py": ["__init__.py", "src/pkg/__init__.py"]}
+    resolve = selection._frame_file
+    assert resolve("/home/u/venv/lib/python3.8/site-packages/pkg/core.py", by_name) == "src/pkg/core.py"
+    assert resolve("C:\\env\\Lib\\site-packages\\pkg\\core.py", by_name) == "src/pkg/core.py"
+    assert resolve("/home/u/checkout/src/pkg/core.py", by_name) == "src/pkg/core.py"
+    assert resolve("/usr/lib/python3/site-packages/numpy/__init__.py", by_name) is None   # another library
+    assert resolve("script.py", by_name) is None
+
+
+def _pack(tmp_path, n_callables=12, fillers=30):
+    src = tmp_path / "src"
+    (src / "pkg" / "ops").mkdir(parents=True)
+    (src / "pkg" / "ops" / "base.py").write_text(
+        "import math\n\n\n"
+        "class Scaler:\n    def __call__(self, value):\n        return value * self.factor\n\n\n"
+        "class Converter:\n    offset = 1\n\n    def __call__(self, value):\n"
+        "        return value + self.offset\n")
+    for i in range(n_callables):          # __call__ is defined too often for the definition channel
+        (src / "pkg" / "ops" / f"base_thing{i}.py").write_text(
+            f"class Thing{i}:\n    def __call__(self, value):\n        return value - {i}\n")
+    prose = ("    Negative values: the wrong result for negative values when calling __call__ on a value\n"
+             "    returns a wrong result from the base ops of pkg.\n")
+    for i in range(fillers):              # blocks that match the issue better and fill a 2K budget
+        (src / "pkg" / "ops" / f"base_notes{i}.py").write_text(
+            f"def describe_{i}():\n    '''\n" + prose * 6 + f"    '''\n    return {i}\n")
+    pack = tmp_path / "p.npk"
+    compile_pack(src, pack)
+    return pack
+
+
+def _ids(pack, query, budget, **options):
+    with PackSelector(str(pack), enable_cache=False, **options) as selector:
+        return [e.span for e in selector.select(query, budget_tokens=budget, allow_escalation=False).evidence]
+
+
+def test_the_frame_line_picks_among_same_named_functions(tmp_path):
+    pack = _pack(tmp_path)
+    with open_pack(pack) as con:
+        ranked = selection._traceback_channel(con, TRACEBACK.format(line=13), 60)
+        rows = con.execute("SELECT id, name FROM blocks WHERE id IN (%s)" % ",".join("?" * len(ranked)),
+                           ranked).fetchall()
+    assert [name for _, name in rows] == ["Converter"]
+
+
+def test_frame_function_leads_the_selection_from_2k_only(tmp_path):
+    pack = _pack(tmp_path)
+    query = TRACEBACK.format(line=13)
+    assert _ids(pack, query, 2048)[0] == "pkg/ops/base.py:9-13"     # the innermost frame's function
+    assert _ids(pack, query, 2048, enable_traceback_frames=False)[0] != "pkg/ops/base.py:9-13"
+    assert _ids(pack, query, 1024) == _ids(pack, query, 1024, enable_traceback_frames=False)
+
+
+def test_option_is_validated(tmp_path):
+    pack = _pack(tmp_path, n_callables=0, fillers=0)
+    with pytest.raises(ValueError):
+        PackSelector(str(pack), enable_traceback_frames="yes")
