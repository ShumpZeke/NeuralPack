     return list(dict.fromkeys(names))
 
 
+#: Traceback frames (E055b): the functions a pasted Python traceback passes through,
+#: innermost first, form their own ranked channel, fused by RRF ahead of the others.
+#: Frames are read in the formats users paste (CPython ``File "p", line N, in f``,
+#: IPython 8 ``File p:N, in f(``, IPython 7 ``p in f(``, pytest ``p:N: in f``). A frame's
+#: path resolves to the pack file with the longest matching path suffix (after
+#: ``site-packages/``), its function to that file's defining blocks (the frame's line
+#: chooses among same-named definitions; a ``Class.method`` qualifier picks the class's
+#: blocks), and a ``<module>``/comprehension frame to the block containing its line.
+#: Frames outside the repository resolve to nothing. From ``TRACEBACK_MIN_BUDGET`` up
+#: only: below it the frame blocks displaced as many fix sites as they added (dev).
+#: gym-dev: fix +0.6 / +0.7 at 2K / 4K (E055b).
+TRACEBACK_MIN_BUDGET = 2048
+_FRAME_PY = r"\.pyx?"
+_FRAME_PATTERNS = (
+    re.compile(r'File "(?P<path>[^"\n]+?' + _FRAME_PY + r')", line (?P<line>\d+)(?:, in (?P<func>[\w<>.]+))?'),
+    re.compile(r'File (?P<path>[^\s"]+?' + _FRAME_PY + r'):(?P<line>\d+)(?:, in (?P<func>[\w<>.]+))?'),
+    re.compile(r'^[ \t]*(?P<path>(?:~|/|[A-Za-z]:\\)\S*?' + _FRAME_PY + r') in (?P<func>[\w<>.]+)\(', re.M),
+    re.compile(r'^[ \t]*(?P<path>[^\s:"]+?' + _FRAME_PY + r'):(?P<line>\d+): in (?P<func>[\w<>.]+)', re.M),
+)
+#: A frame whose function has more definitions than this in its file, and no line to
+#: choose among them, is skipped.
+FRAME_MAX_SAME_NAME = 3
+
+
+def _traceback_frames(text: str) -> List[Tuple[str, Optional[int], Optional[str]]]:
+    """``(path, line, function)`` of every traceback frame, in text order (innermost last)."""
+    found: Dict[int, Tuple[str, Optional[int], Optional[str]]] = {}
+    for pattern in _FRAME_PATTERNS:
+        for match in pattern.finditer(text):
+            line = match.groupdict().get("line")
+            found.setdefault(match.start(), (match.group("path"), int(line) if line else None, match.group("func")))
+    return [found[k] for k in sorted(found)]
+
+
+def _frame_file(path: str, by_name: Dict[str, List[str]]) -> Optional[str]:
+    """The pack file a frame path names: the longest match on a path boundary."""
+    tail = path.replace("\\", "/")
+    for marker in ("/site-packages/", "/dist-packages/"):
+        if marker in tail:
+            tail = tail.rsplit(marker, 1)[1]
+            break
+    else:
+        while tail.startswith("./"):
+            tail = tail[2:]
+        tail = tail.lstrip("/")
+    best = None
+    for candidate in by_name.get(tail.rsplit("/", 1)[-1], ()):
+        if (candidate == tail or ("/" in candidate and tail.endswith("/" + candidate))
+                or ("/" in tail and candidate.endswith("/" + tail))):
+            if best is None or len(candidate) > len(best):
+                best = candidate
+    return best
+
+
+def _frame_blocks(con: sqlite3.Connection, path: str, line: Optional[int], func: Optional[str]) -> List[int]:
+    if func and not func.startswith("<"):
+        qualifier, _, name = func.rpartition(".")
+        rows = con.execute(
+            "SELECT b.id, b.start_line, b.end_line, b.name FROM symbols s JOIN blocks b ON b.id=s.block_id "
+            "JOIN files f ON f.id=b.file_id WHERE s.is_def=1 AND s.name=? AND f.path=? "
+            "ORDER BY b.start_line", (name, path)).fetchall()
+        if qualifier:
+            owner = qualifier.rsplit(".", 1)[-1]
+            rows = [r for r in rows if r[3] == owner] or rows
+        if line is not None:
+            rows = [r for r in rows if r[1] <= line <= r[2]] or rows
+        return [] if len(rows) > FRAME_MAX_SAME_NAME else [r[0] for r in rows]
+    if line is None:
+        return []
+    return [r[0] for r in con.execute(
+        "SELECT b.id FROM blocks b JOIN files f ON f.id=b.file_id WHERE f.path=? AND b.start_line<=? "
+        "AND b.end_line>=? ORDER BY b.start_line", (path, line, line))]
+
+
+def _traceback_channel(con: sqlite3.Connection, query: str, limit: int) -> List[int]:
+    """Blocks defining the functions of the query's traceback frames, innermost first."""
+    frames = _traceback_frames(query)
+    if not frames:
+        return []
+    by_name: Dict[str, List[str]] = {}
+    for (path,) in con.execute("SELECT path FROM files"):
+        if path.endswith((".py", ".pyx", ".pyi")):
+            by_name.setdefault(path.rsplit("/", 1)[-1], []).append(path)
+    ranked: List[int] = []
+    for path, line, func in reversed(frames):
+        resolved = _frame_file(path, by_name)
+        if resolved is None:
+            continue
+        blocks = [b for b in _frame_blocks(con, resolved, line, func) if b not in ranked]
+        ranked.extend(blocks)
+        if len(ranked) >= limit:
+            break
+    return ranked[:limit]
+
+
